{
  "name": "hnas-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .ts src",
    "test": "npm run build && node --test \"lib/tests/**/*.test.js\"",
    "serve": "npm run build && bash ../scripts/firebase-emulators.sh",
    "deploy": "set -a; [ -f ../.env ] && . ../.env; set +a; npm run build && npx --yes firebase-tools deploy --config ../firebase.json --only functions",
    "seed:demo": "node scripts/seed-demo.js",
    "migrate:insulin-profiles": "node scripts/migrate-inline-insulin-profiles.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "typescript": "^5.6.3"
  }
}
